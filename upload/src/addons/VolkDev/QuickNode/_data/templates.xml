  <template type="admin" title="volkdev_qn_log_list" version_id="1010070" version_string="1.1.0"><![CDATA[<xf:title>{{ phrase('volkdev_qnc_logs_title') }}</xf:title>
<xf:if is="$username">
    <xf:pageaction>
        <xf:button href="{{ link('qnc-logs/mass-revert', null, {'username': $username, 'timeframe': $timeframe}) }}" overlay="true" icon="refresh">
            {{ phrase('volkdev_qnc_mass_revert_btn', {'username': $username, 'period': $periodLabel}) }}
        </xf:button>
    </xf:pageaction>
</xf:if>

<xf:form action="{{ link('qnc-logs') }}" class="block">
    <div class="block-container">
        <div class="block-body">
            <xf:textboxrow name="username" value="{$username}" label="{{ phrase('volkdev_qnc_filter_username') }}" />
            <xf:radiorow name="timeframe" value="{$timeframe}" label="{{ phrase('volkdev_qnc_filter_period') }}">
                <xf:option value="1h">{{ phrase('volkdev_qnc_period_1h') }}</xf:option>
                <xf:option value="6h">{{ phrase('volkdev_qnc_period_6h') }}</xf:option>
                <xf:option value="24h">{{ phrase('volkdev_qnc_period_24h') }}</xf:option>
                <xf:option value="7d">{{ phrase('volkdev_qnc_period_7d') }}</xf:option>
                <xf:option value="30d">{{ phrase('volkdev_qnc_period_30d') }}</xf:option>
                <xf:option value="all">{{ phrase('volkdev_qnc_period_all') }}</xf:option>
            </xf:radiorow>
            <xf:selectrow name="action" value="{$actionFilter}" label="{{ phrase('volkdev_qnc_filter_action') }}">
                <xf:option value="">{{ phrase('volkdev_qnc_filter_all_actions') }}</xf:option>
                <xf:option value="create">{{ phrase('volkdev_qnc_action_create') }}</xf:option>
                <xf:option value="edit">{{ phrase('volkdev_qnc_action_edit') }}</xf:option>
                <xf:option value="perm_change">{{ phrase('volkdev_qnc_action_perm_change') }}</xf:option>
                <xf:option value="pending_delete">{{ phrase('volkdev_qnc_action_pending_delete') }}</xf:option>
                <xf:option value="delete">{{ phrase('volkdev_qnc_action_delete') }}</xf:option>
            </xf:selectrow>
        </div>
        <xf:submitrow submit="{{ phrase('volkdev_qnc_btn_filter') }}" icon="search" />
    </div>
</xf:form>

<div class="block">
    <div class="block-container">
        <xf:if is="$logs is not empty">
            <xf:datalist>
                <xf:datarow rowtype="header">
                    <xf:cell>{{ phrase('volkdev_qnc_col_date') }}</xf:cell>
                    <xf:cell>{{ phrase('volkdev_qnc_col_moderator') }}</xf:cell>
                    <xf:cell>{{ phrase('volkdev_qnc_col_action') }}</xf:cell>
                    <xf:cell>{{ phrase('volkdev_qnc_col_node') }}</xf:cell>
                    <xf:cell>&nbsp;</xf:cell>
                </xf:datarow>
                <xf:foreach loop="$logs" value="$log">
                    <xf:datarow>
                        <xf:cell><xf:date time="{$log.log_date}" /></xf:cell>
                        <xf:cell>
                            <xf:if is="$log.User">{$log.User.username}<xf:else />{{ phrase('guest') }}</xf:if>
                            <xf:if is="$log.ip_address"><br /><span class="u-muted" style="font-size: 11px;">IP: {{ $log.ip_address|ip }}</span></xf:if>
                        </xf:cell>
                        <xf:cell>{$log.action_label}</xf:cell>
                        <xf:cell>
                            <xf:if is="$log.Node">
                                <a href="{{ link('forums', $log.Node) }}">{{ $log.Node.title }}</a>
                            <xf:else />
                                {{ $log.old_data.title ?: $log.new_data.title ?: $log.old_data.node_title ?: phrase('volkdev_qnc_deleted_or_unknown') }}
                            </xf:if>
                        </xf:cell>
                        <xf:cell>
                            <xf:if is="$log.action == 'pending_delete'">
                                <xf:button href="{{ link('qnc-logs/approve', null, {'log_id': $log.log_id}) }}" overlay="true" icon="confirm">{{ phrase('volkdev_qnc_btn_approve') }}</xf:button>
                                <xf:button href="{{ link('qnc-logs/reject', null, {'log_id': $log.log_id}) }}" overlay="true" icon="cancel">{{ phrase('volkdev_qnc_btn_reject') }}</xf:button>
                            <xf:elseif is="$log.action != 'delete' AND $log.action != 'reverted' AND $log.action != 'rejected'" />
                                <xf:button href="{{ link('qnc-logs/revert', null, {'log_id': $log.log_id}) }}" overlay="true">{{ phrase('volkdev_qnc_btn_revert') }}</xf:button>
                            </xf:if>
                            <xf:button href="{{ link('qnc-logs/view', null, {'log_id': $log.log_id}) }}" overlay="true" icon="preview">{{ phrase('volkdev_qnc_btn_view_details') }}</xf:button>
                        </xf:cell>
                    </xf:datarow>
                </xf:foreach>
            </xf:datalist>
        <xf:else />
            <div class="block-body block-row">{{ phrase('volkdev_qnc_no_logs_found') }}</div>
        </xf:if>
    </div>
</div>

<xf:pagenav page="{$page}" perpage="{$perPage}" total="{$total}" link="qnc-logs" params="{{ {'username': $username, 'timeframe': $timeframe, 'action': $actionFilter} }}" />]]></template>
