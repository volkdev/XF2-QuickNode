</div>]]></template>
  <template type="public" title="volkdev_qn_permissions_edit" version_id="3030570" version_string="3.3.5"><![CDATA[<xf:title>{{ phrase('volkdev_qnc_permissions_edit_title', {'title': $userGroup.title}) }}</xf:title>

