  <template type="public" title="volkdev_qn_edit" version_id="3030470" version_string="3.3.4"><![CDATA[<xf:title>{{ phrase('volkdev_qnc_edit_title', {'title': $node.title}) }}</xf:title>
<xf:form action="{{ link('quick-node/edit', null, {'node_id': $node.node_id}) }}" ajax="true" class="block">
    <div class="block-container">
        <div class="block-body">
            <xf:textboxrow name="node[title]" value="{$node.title}" label="{{ phrase('title') }}" required="required" />
            <xf:textarearow name="node[description]" value="{$node.description}" label="{{ phrase('description') }}" autosize="true" />

            <xf:selectrow name="node[parent_node_id]" value="{$node.parent_node_id}" label="{{ phrase('parent_node') }}">
                <xf:option value="0">{{ phrase('none') }}</xf:option>
                <xf:foreach loop="$nodeOptions" value="$nodeOption">
                    <xf:option value="{$nodeOption.value}" disabled="{$nodeOption.disabled}">
                        {{ repeat('--', $nodeOption.depth) }} {$nodeOption.label}
                    </xf:option>
                </xf:foreach>
            </xf:selectrow>
            
            <xf:numberboxrow name="node[display_order]" value="{$node.display_order}" min="0" label="{{ phrase('display_order') }}" />

            <xf:if is="$node.node_type_id == 'LinkForum'">
                <xf:textboxrow name="link_url" value="{$linkUrl}" label="{{ phrase('link_url') }}" />
            </xf:if>
            
            <xf:checkboxrow>
                <xf:option name="is_private" value="1" checked="{$isPrivate}" label="{{ phrase('volkdev_qnc_private_node') }}" explain="{{ phrase('volkdev_qnc_private_node_explain') }}" />
            </xf:checkboxrow>

            <xf:if is="$node.node_type_id == 'Forum'">
                <xf:checkboxrow>
                    <xf:option name="allow_posting" value="1" checked="{$allowPosting}" label="{{ phrase('volkdev_qnc_allow_posting') }}" explain="{{ phrase('volkdev_qnc_allow_posting_explain') }}" />
                </xf:checkboxrow>
                
                <xf:if is="$prefixGroups is not empty">
                    <xf:checkboxrow label="{{ phrase('thread_prefixes') }}">
                        <xf:foreach loop="$prefixGroups" key="$groupId" value="$prefixGroup">
                            <xf:if is="{$prefixesGrouped.{$groupId}}">
                                <xf:foreach loop="{$prefixesGrouped.{$groupId}}" value="$prefix">
                                    <xf:option name="available_prefixes[]" value="{$prefix.prefix_id}" checked="{{ in_array($prefix.prefix_id, $availablePrefixes) }}">{{ $groupId ? $prefixGroup.title . ' - ' : '' }}{{ $prefix.title }}</xf:option>
                                </xf:foreach>
                            </xf:if>
                        </xf:foreach>
                    </xf:checkboxrow>
                </xf:if>
            </xf:if>
        </div>
        <xf:submitrow submit="{{ phrase('volkdev_qnc_btn_save') }}" icon="save" />
    </div>
</xf:form>]]></template>
  <template type="public" title="volkdev_qn_index" version_id="3030470" version_string="3.3.4"><![CDATA[<xf:title>{{ phrase('volkdev_qnc_create_node_title') }}</xf:title>

<xf:form action="{{ link('quick-node/save') }}" ajax="true" class="block">
	<xf:hiddenval name="node[parent_node_id]" value="{$parentNodeId}" />
    <div class="block-container">
        <div class="block-body">
            <xf:textboxrow name="node[title]" label="{{ phrase('title') }}" required="required" />
            <xf:textarearow name="node[description]" label="{{ phrase('description') }}" autosize="true" />

            <xf:selectrow name="node[parent_node_id]" value="{$parentNodeId}" label="{{ phrase('parent_node') }}">
                <xf:option value="0">{{ phrase('none') }}</xf:option>
                <xf:foreach loop="$nodeOptions" value="$nodeOption">
                    <xf:option value="{$nodeOption.value}" disabled="{$nodeOption.disabled}">
                        {{ repeat('--', $nodeOption.depth) }} {$nodeOption.label}
                    </xf:option>
                </xf:foreach>
            </xf:selectrow>

            <xf:numberboxrow name="node[display_order]" value="1" min="0" label="{{ phrase('display_order') }}" />

            <xf:radiorow name="node[node_type_id]" label="{{ phrase('node_type') }}" value="Forum">
                <xf:option value="Category" label="{{ phrase('node_type.Category') }}" />
                <xf:option value="Forum" data-hide="true" label="{{ phrase('node_type.Forum') }}">
                    <xf:dependent>
                        <div style="padding-top: 5px; padding-bottom: 5px;">
                            <xf:checkbox>
                                <xf:option name="allow_posting" value="1" checked="true" label="{{ phrase('volkdev_qnc_allow_posting') }}" explain="{{ phrase('volkdev_qnc_allow_posting_explain') }}" />
                            </xf:checkbox>
                        </div>
                        <xf:if is="$prefixGroups is not empty">
                            <div style="padding-top: 5px;">
                                <div style="margin-bottom: 3px;">{{ phrase('thread_prefixes') }}:</div>
                                <xf:checkbox>
                                    <xf:foreach loop="$prefixGroups" key="$groupId" value="$prefixGroup">
                                        <xf:if is="{$prefixesGrouped.{$groupId}}">
                                            <xf:foreach loop="{$prefixesGrouped.{$groupId}}" value="$prefix">
                                                <xf:option name="available_prefixes[]" value="{$prefix.prefix_id}">{{ $groupId ? $prefixGroup.title . ' - ' : '' }}{{ $prefix.title }}</xf:option>
                                            </xf:foreach>
                                        </xf:if>
                                    </xf:foreach>
                                </xf:checkbox>
                            </div>
                        </xf:if>
                    </xf:dependent>
                </xf:option>
                <xf:option value="LinkForum" data-hide="true" label="{{ phrase('node_type.LinkForum') }}">
                    <xf:dependent>
                        <xf:textbox name="link_url" label="{{ phrase('link_url') }}" explain="{{ phrase('volkdev_qnc_link_url_explain') }}" style="margin-top: 5px;" />
                    </xf:dependent>
                </xf:option>
            </xf:radiorow>

            <xf:checkboxrow>
                <xf:option name="is_private" value="1" label="{{ phrase('volkdev_qnc_private_node') }}" explain="{{ phrase('volkdev_qnc_private_node_explain') }}" />
            </xf:checkboxrow>

        </div>
        <xf:submitrow submit="{{ phrase('volkdev_qnc_btn_create') }}" icon="save" />
    </div>
</xf:form>]]></template>
