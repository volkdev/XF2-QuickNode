  <template type="public" title="volkdev_qn_moderators" version_id="1010070" version_string="1.2.0"><![CDATA[<xf:title>{{ phrase('volkdev_qnc_local_moderators') }}: {$node.title}</xf:title>

<xf:form action="{{ link('quick-node/moderators', null, {'node_id': $node.node_id}) }}" ajax="true" class="block">
    <div class="block-container">
        <div class="block-body">
            <xf:textboxrow name="username" label="{{ phrase('user_name') }}" required="required" />
        </div>
        <xf:submitrow submit="{{ phrase('volkdev_qnc_add_moderator') }}" icon="add" />
    </div>
</xf:form>

<div class="block">
    <div class="block-container">
        <div class="block-body">
            <xf:if is="$moderators is not empty">
                <xf:foreach loop="$moderators" value="$moderator">
                    <xf:formrow rowclass="formRow--button" label="{$moderator.username}">
                        <xf:button href="{{ link('quick-node/moderators/remove', null, {'node_id': $node.node_id, 'user_id': $moderator.user_id}) }}" class="button--link" overlay="true">
                            {{ phrase('volkdev_qnc_remove_moderator') }}
                        </xf:button>
                    </xf:formrow>
                </xf:foreach>
            <xf:else />
