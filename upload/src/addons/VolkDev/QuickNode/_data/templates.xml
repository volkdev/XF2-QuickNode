  <template type="admin" title="volkdev_qnc_perm_template_edit" version_id="3030570" version_string="3.3.5"><![CDATA[<xf:if is="$template.isInsert()">
    <xf:title>{{ phrase('volkdev_qnc_add_perm_template') }}</xf:title>
<xf:else />
    <xf:title>{{ phrase('volkdev_qnc_edit_perm_template', {'title': $template.title}) }}</xf:title>
</xf:if>

<xf:pageaction is="!$template.isInsert()">
    <xf:button href="{{ link('qnc-perm-templates/delete', $template) }}" icon="delete" overlay="true" />
</xf:pageaction>

<xf:form action="{{ link('qnc-perm-templates/save', $template) }}" ajax="true" class="block">
    <div class="block-container">
        <div class="block-body">
            <xf:textboxrow name="title" value="{$template.title}" label="{{ phrase('title') }}" required="required" />
            <xf:textarearow name="description" value="{$template.description}" label="{{ phrase('description') }}" autosize="true" explain="{{ phrase('volkdev_qnc_perm_template_desc_explain') }}" />

            <xf:numberboxrow name="display_order" value="{$template.display_order}" min="0" label="{{ phrase('display_order') }}" />
            
            <xf:checkboxrow>
                <xf:option name="active" value="1" checked="{$template.active}" label="{{ phrase('volkdev_qnc_active') }}" />
                <xf:option name="admin_only" value="1" checked="{$template.admin_only}" label="{{ phrase('volkdev_qnc_admin_only_apply') }}" explain="{{ phrase('volkdev_qnc_admin_only_apply_explain') }}" />
            </xf:checkboxrow>

            <hr class="formRowSep" />

            <!-- Applicable Nodes -->
            <xf:formrow rowtype="input" label="{{ phrase('volkdev_qnc_applicable_nodes') }}" explain="{{ phrase('volkdev_qnc_applicable_nodes_explain') }}">
                <ul class="inputList">
                    <li>
                        <xf:select name="node_ids[]" size="7" multiple="multiple" id="js-applicableNodes">
                            <xf:option value="" selected="!$template.node_ids">{{ phrase('volkdev_qnc_all_nodes') }}</xf:option>
                            <xf:foreach loop="$nodeTree.getFlattened(0)" value="$treeEntry">
                                <xf:option value="{$treeEntry.record.node_id}"
                                    selected="{{ in_array($treeEntry.record.node_id, $template.node_ids) }}"
                                    label="{{ repeat('&nbsp;&nbsp;', $treeEntry.depth)|raw }} {$treeEntry.record.title}" />
                            </xf:foreach>
                        </xf:select>
                    </li>
                    <li>
                        <xf:checkbox>
                            <xf:option label="{{ phrase('select_all') }}" id="js-selectAllNodes" />
                        </xf:checkbox>
                    </li>
                </ul>
            </xf:formrow>
            <xf:js>
                $(function()
                {
                    $('#js-selectAllNodes').click(function(e)
                    {
                        $('#js-applicableNodes').find('option:enabled:not([value=""])').prop('selected', this.checked);
                    });
                });
            </xf:js>

            <!-- Applicable User Groups -->
            <xf:radiorow name="user_group_scope" value="{$template.user_group_scope}" label="{{ phrase('volkdev_qnc_applicable_groups') }}">
                <xf:option value="all" label="{{ phrase('volkdev_qnc_all_user_groups') }}" />
                <xf:option value="selected" label="{{ phrase('volkdev_qnc_specified_user_groups_only') }}">
                    <xf:dependent>
                        <div class="inputChoices-dependencies" style="max-height: 200px; overflow-y: auto; padding: 5px; border: 1px solid #dfdfdf; border-radius: 4px;">
                            <xf:checkbox name="user_group_ids[]">
                                <xf:foreach loop="$userGroups" value="$userGroup">
                                    <xf:option value="{$userGroup.user_group_id}" checked="{{ in_array($userGroup.user_group_id, $template.user_group_ids) }}">
                                        {$userGroup.title}
                                    </xf:option>
                                </xf:foreach>
                            </xf:checkbox>
                        </div>
                    </xf:dependent>
                </xf:option>
            </xf:radiorow>

            <xf:macro template="permission_macros" name="edit_outer" arg-type="content" />

            <xf:macro template="permission_macros" name="content_edit_groups"
                arg-interfaceGroups="{$permissionData.interfaceGroups}"
                arg-permissionsGrouped="{$permissionData.permissionsGrouped}"
                arg-values="{$template.permissions}" />

        </div>
        <xf:submitrow submit="{{ phrase('volkdev_qnc_btn_save') }}" icon="save" />
    </div>
</xf:form>]]></template>
  <template type="admin" title="volkdev_qnc_perm_template_list" version_id="3030570" version_string="3.3.5"><![CDATA[<xf:title>{{ phrase('volkdev_qnc_perm_templates') }}</xf:title>

<xf:pageaction>
    <xf:button href="{{ link('qnc-perm-templates/add') }}" icon="add">{{ phrase('volkdev_qnc_add_perm_template') }}</xf:button>
</xf:pageaction>

<div class="block">
    <div class="block-container">
        <xf:if is="$templates is not empty">
            <xf:datalist>
                <xf:datarow rowtype="header">
                    <xf:cell>{{ phrase('title') }}</xf:cell>
                    <xf:cell>{{ phrase('volkdev_qnc_applicable_nodes') }}</xf:cell>
                    <xf:cell>{{ phrase('volkdev_qnc_applicable_groups') }}</xf:cell>
                    <xf:cell>{{ phrase('volkdev_qnc_admin_only_badge') }}</xf:cell>
                    <xf:cell class="dataList-cell--min">&nbsp;</xf:cell>
                    <xf:cell class="dataList-cell--min">&nbsp;</xf:cell>
                </xf:datarow>
                <xf:foreach loop="$templates" value="$template">
                    <xf:datarow>
                        <xf:cell>
                            <a href="{{ link('qnc-perm-templates/edit', $template) }}"><strong>{$template.title}</strong></a>
                            <xf:if is="$template.description">
                                <div class="u-muted" style="font-size: 11px;">{$template.description}</div>
                            </xf:if>
                        </xf:cell>
                        <xf:cell>
                            <xf:if is="$template.node_scope == 'all'">
                                <span class="label label--primary">{{ phrase('volkdev_qnc_all_nodes') }}</span>
                            <xf:else />
                                <span class="label label--accent">{{ count($template.node_ids) }} {{ phrase('nodes') }}</span>
                            </xf:if>
                        </xf:cell>
                        <xf:cell>
                            <xf:if is="$template.user_group_scope == 'all'">
                                <span class="label label--primary">{{ phrase('volkdev_qnc_all_user_groups') }}</span>
                            <xf:else />
                                <span class="label label--accent">{{ count($template.user_group_ids) }} {{ phrase('user_groups') }}</span>
                            </xf:if>
                        </xf:cell>
                        <xf:cell>
                            <xf:if is="$template.admin_only">
                                <span class="label label--red">{{ phrase('yes') }}</span>
                            <xf:else />
                                <span class="u-muted">{{ phrase('no') }}</span>
                            </xf:if>
                        </xf:cell>
                        <xf:toggle cell="true" href="{{ link('qnc-perm-templates/toggle') }}"
                            name="active"
                            rowid="template_id-{$template.template_id}"
                            data-key="template_id"
                            data-value="{$template.template_id}"
                            selected="{$template.active}"
                            tooltip="{{ phrase('volkdev_qnc_enable_disable_template') }}" />
                        <xf:delete cell="true" href="{{ link('qnc-perm-templates/delete', $template) }}" />
                    </xf:datarow>
                </xf:foreach>
            </xf:datalist>
        <xf:else />
            <div class="block-body block-row">{{ phrase('no_items_have_been_created_yet') }}</div>
        </xf:if>
    </div>
</div>]]></template>
</templates>
