  <template type="admin" title="volkdev_qn_log_view" version_id="1010070" version_string="1.1.0"><![CDATA[<xf:title>{{ phrase('volkdev_qnc_log_detail_title') }}</xf:title>
<div class="block">
    <div class="block-container">
        <div class="block-body">
            <xf:formrow label="{{ phrase('volkdev_qnc_col_date') }}">
                <xf:date time="{$log.log_date}" />
            </xf:formrow>
            <xf:formrow label="{{ phrase('volkdev_qnc_col_moderator') }}">
                {$log.User.username}
            </xf:formrow>
            <xf:formrow label="{{ phrase('volkdev_qnc_col_action') }}">
                {$log.action_label}
            </xf:formrow>
            <xf:formrow label="{{ phrase('volkdev_qnc_col_node') }}">
                <xf:if is="$log.Node">
                    <a href="{{ link('forums', $log.Node) }}">{{ $log.Node.title }}</a>
                <xf:else />
                    {{ phrase('volkdev_qnc_deleted_or_unknown') }}
                </xf:if>
            </xf:formrow>
        </div>
    </div>
</div>

<xf:if is="$log.old_data">
<div class="block">
    <div class="block-header">{{ phrase('volkdev_qnc_log_old_data') }}</div>
    <div class="block-container">
        <div class="block-body">
            <xf:foreach loop="$log.old_data" key="$key" value="$val">
                <xf:formrow label="{$key}">
                    <xf:if is="is_array($val)">{{ $val|json }}<xf:else />{$val}</xf:if>
                </xf:formrow>
            </xf:foreach>
        </div>
    </div>
</div>
</xf:if>

<xf:if is="$log.new_data">
<div class="block">
    <div class="block-header">{{ phrase('volkdev_qnc_log_new_data') }}</div>
    <div class="block-container">
        <div class="block-body">
            <xf:foreach loop="$log.new_data" key="$key" value="$val">
                <xf:formrow label="{$key}">
                    <xf:if is="is_array($val)">{{ $val|json }}<xf:else />{$val}</xf:if>
                </xf:formrow>
            </xf:foreach>
        </div>
    </div>
</div>
</xf:if>

<xf:if is="!$log.old_data AND !$log.new_data">
<div class="block">
    <div class="block-container">
        <div class="block-body block-row">{{ phrase('volkdev_qnc_log_no_data') }}</div>
    </div>
</div>
</xf:if>]]></template>
