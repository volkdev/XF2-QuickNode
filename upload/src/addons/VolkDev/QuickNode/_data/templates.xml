  <template type="admin" title="volkdev_qn_log_view" version_id="1010070" version_string="1.1.0"><![CDATA[<xf:title>{{ phrase('volkdev_qnc_log_detail_title') }}</xf:title>
<div class="block">
    <div class="block-container">
        <div class="block-body">
            <xf:formrow label="{{ phrase('volkdev_qnc_col_date') }}">
                <xf:date time="{$log.log_date}" />
            </xf:formrow>
            <xf:formrow label="{{ phrase('volkdev_qnc_col_moderator') }}">
                {$log.User.username}
            </xf:formrow>
            <xf:formrow label="{{ phrase('volkdev_qnc_col_action') }}">
                {$log.action_label}
            </xf:formrow>
            <xf:formrow label="{{ phrase('volkdev_qnc_col_node') }}">
                <xf:if is="$log.Node">
                    <a href="{{ link('forums', $log.Node) }}">{{ $log.Node.title }}</a>
                <xf:else />
                    {{ phrase('volkdev_qnc_deleted_or_unknown') }}
                </xf:if>
            </xf:formrow>
        </div>
    </div>
</div>

<xf:if is="$log.old_data">
<div class="block">
    <div class="block-header">{{ phrase('volkdev_qnc_log_old_data') }}</div>
    <div class="block-container">
        <div class="block-body">
            <xf:foreach loop="$log.old_data" key="$key" value="$val">
                <xf:if is="$key == 'group_id'">
                    <xf:formrow label="{{ phrase('user_group') }}">
                        <xf:if is="{$userGroups.{$val}}">
                            {$val} ({$userGroups.{$val}.title})
                        <xf:else />
                            {$val}
                        </xf:if>
                    </xf:formrow>
                <xf:elseif is="$key == 'node_title'" />
                    <xf:formrow label="{{ phrase('node') }}">
                        {$val}
                    </xf:formrow>
                <xf:elseif is="$key == 'perms'" />
                    <xf:formrow label="{{ phrase('permissions') }}">
                        <xf:macro name="log_array_renderer" arg-data="{$val}" arg-isPerms="1" />
                    </xf:formrow>
                <xf:elseif is="$key == 'templates'" />
                    <xf:formrow label="{{ phrase('volkdev_qnc_perm_templates') }}">
                        <xf:macro name="log_array_renderer" arg-data="{$val}" />
                    </xf:formrow>
                <xf:elseif is="$key == 'is_private'" />
                    <xf:formrow label="{{ phrase('private_node') }}">
                        <xf:macro name="log_array_renderer" arg-data="{$val}" />
                    </xf:formrow>
                <xf:else />
                    <xf:formrow label="{$key}">
                        <xf:macro name="log_array_renderer" arg-data="{$val}" />
                    </xf:formrow>
                </xf:if>
            </xf:foreach>
        </div>
    </div>
</div>
</xf:if>

<xf:if is="$log.new_data">
<div class="block">
    <div class="block-header">{{ phrase('volkdev_qnc_log_new_data') }}</div>
    <div class="block-container">
        <div class="block-body">
            <xf:foreach loop="$log.new_data" key="$key" value="$val">
                <xf:if is="$key == 'group_id'">
                    <xf:formrow label="{{ phrase('user_group') }}">
                        <xf:if is="{$userGroups.{$val}}">
                            {$val} ({$userGroups.{$val}.title})
                        <xf:else />
                            {$val}
                        </xf:if>
                    </xf:formrow>
                <xf:elseif is="$key == 'node_title'" />
                    <xf:formrow label="{{ phrase('node') }}">
                        {$val}
                    </xf:formrow>
                <xf:elseif is="$key == 'perms'" />
                    <xf:formrow label="{{ phrase('permissions') }}">
                        <xf:macro name="log_array_renderer" arg-data="{$val}" arg-isPerms="1" />
                    </xf:formrow>
                <xf:elseif is="$key == 'templates'" />
                    <xf:formrow label="{{ phrase('volkdev_qnc_perm_templates') }}">
                        <xf:macro name="log_array_renderer" arg-data="{$val}" />
                    </xf:formrow>
                <xf:elseif is="$key == 'is_private'" />
                    <xf:formrow label="{{ phrase('private_node') }}">
                        <xf:macro name="log_array_renderer" arg-data="{$val}" />
                    </xf:formrow>
                <xf:else />
                    <xf:formrow label="{$key}">
                        <xf:macro name="log_array_renderer" arg-data="{$val}" />
                    </xf:formrow>
                </xf:if>
            </xf:foreach>
        </div>
    </div>
</div>
</xf:if>

<xf:if is="!$log.old_data AND !$log.new_data">
<div class="block">
    <div class="block-container">
        <div class="block-body block-row">{{ phrase('volkdev_qnc_log_no_data') }}</div>
    </div>
</div>
</xf:if>

<xf:macro name="log_array_renderer" arg-data="!" arg-isPerms="0" arg-parentKey="">
    <xf:if is="is_array($data)">
        <ul style="list-style-type: none; margin: 0; padding: 0;">
            <xf:foreach loop="$data" key="$k" value="$v">
                <li style="margin-bottom: 3px;">
                    <strong>
                        <xf:if is="is_numeric($k)">
                            - 
                        <xf:else />
                            <xf:if is="$isPerms">
                                <xf:if is="$parentKey">
                                    {{ phrase_dynamic('permission.' . $parentKey . '_' . $k) }}: 
                                <xf:else />
                                    {{ phrase_dynamic('permission_interface.' . $k) }}: 
                                </xf:if>
                            <xf:else />
                                {$k}: 
                            </xf:if>
                        </xf:if>
                    </strong> 
                    <xf:if is="is_array($v)">
                        <div style="padding-left: 15px; border-left: 2px solid #dfdfdf; margin-left: 5px; margin-top: 3px;">
                            <xf:macro name="log_array_renderer" arg-data="{$v}" arg-isPerms="{$isPerms}" arg-parentKey="{$k}" />
                        </div>
                    <xf:else />
                        <xf:if is="$v === 'content_allow'">
                            <span style="color: green;">{{ phrase('yes') }}</span>
                        <xf:elseif is="$v === 'reset' OR $v === 'unset'" />
                            <span style="color: #888;">{{ phrase('no') }}</span>
                        <xf:elseif is="$v === 'deny'" />
                            <span style="color: red;">{{ phrase('never') }}</span>
                        <xf:else />
                            {$v}
                        </xf:if>
                    </xf:if>
                </li>
            </xf:foreach>
        </ul>
    <xf:else />
        {$data}
    </xf:if>
</xf:macro>]]></template>
