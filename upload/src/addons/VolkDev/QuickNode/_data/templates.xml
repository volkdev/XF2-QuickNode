  <template type="public" title="volkdev_qn_permissions_edit" version_id="3030470" version_string="3.3.4"><![CDATA[<xf:title>{{ phrase('volkdev_qnc_permissions_edit_title', {'title': $userGroup.title}) }}</xf:title>

<xf:form action="{{ link('quick-node/permissions/edit', null, {'node_id': $node.node_id, 'user_group_id': $userGroup.user_group_id}) }}" ajax="true" class="block">
    <div class="block-container">
        <div class="block-body">
            
            <xf:radiorow name="view" label="{{ phrase('volkdev_qnc_perm_view') }}">
                <xf:option value="content_allow" selected="$viewState == 'content_allow'">{{ phrase('volkdev_qnc_perm_allow') }}</xf:option>
                <xf:option value="reset" selected="$viewState == 'reset'">{{ phrase('volkdev_qnc_perm_reset') }}</xf:option>
                <xf:option value="deny" selected="$viewState == 'deny'">{{ phrase('volkdev_qnc_perm_deny') }}</xf:option>
                <xf:explain>{{ phrase('volkdev_qnc_perm_view_explain') }}</xf:explain>
            </xf:radiorow>

            <xf:radiorow name="post" label="{{ phrase('volkdev_qnc_perm_post') }}">
                <xf:option value="content_allow" selected="$postState == 'content_allow'">{{ phrase('volkdev_qnc_perm_allow') }}</xf:option>
                <xf:option value="reset" selected="$postState == 'reset'">{{ phrase('volkdev_qnc_perm_reset') }}</xf:option>
                <xf:option value="deny" selected="$postState == 'deny'">{{ phrase('volkdev_qnc_perm_deny') }}</xf:option>
                <xf:explain>{{ phrase('volkdev_qnc_perm_post_explain') }}</xf:explain>
            </xf:radiorow>

            <hr class="formRowSep" />

            <xf:checkboxrow label="{{ phrase('volkdev_qnc_perm_moderation') }}">
                <xf:option name="is_mod" checked="{$isMod}" label="{{ phrase('volkdev_qnc_perm_moderator') }}" hint="{{ phrase('volkdev_qnc_perm_moderator_hint') }}" />
                <xf:option name="is_admin" checked="{$isAdmin}" label="{{ phrase('volkdev_qnc_perm_administrator') }}" hint="{{ phrase('volkdev_qnc_perm_administrator_hint') }}" />
            </xf:checkboxrow>

        </div>
        <xf:submitrow submit="{{ phrase('volkdev_qnc_save_permissions') }}" icon="save" />
    </div>
</xf:form>]]></template>
  <template type="public" title="volkdev_qn_permissions_list" version_id="3030470" version_string="3.3.4"><![CDATA[<xf:title>{{ phrase('volkdev_qnc_permissions_list_title', {'title': $node.title}) }}</xf:title>

<div class="block">
    <div class="block-container">
        <div class="block-body">
            <xf:if is="$groups is not empty">
                <xf:foreach loop="$groups" value="$group">
                    <xf:formrow rowclass="formRow--button" label="{$group.title}">
                        <xf:button href="{{ link('quick-node/permissions/edit', null, {'node_id': $node.node_id, 'user_group_id': $group.user_group_id}) }}" class="button--link">
                            <xf:if is="in_array($group.user_group_id, $customPermGroupIds)">
                                {{ phrase('volkdev_qnc_edit_permissions') }}
                            <xf:else />
                                {{ phrase('volkdev_qnc_configure_permissions') }}
                            </xf:if>
                        </xf:button>
                    </xf:formrow>
                </xf:foreach>
            <xf:else />
                <div class="block-row">{{ phrase('volkdev_qnc_no_groups_available') }}</div>
            </xf:if>
        </div>
    </div>
</div>]]></template>
</templates>
